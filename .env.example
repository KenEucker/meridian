# Local release signing credentials (technical spec 26.5).
#
# Copy to `.env` at the repository root and fill in. `.env` is gitignored;
# this example carries names and shapes only, never values. In CI the same
# variables arrive from repository secrets, so nothing here is required on a
# machine that already exports them — an exported value always wins over a
# line in `.env`.
#
# Read by:
#   corepack pnpm run mobile:android:release
#   corepack pnpm run mobile:ios:release
#
# Full walkthrough, including the one-time provisioning each value comes from:
# docs/process/release-packaging.md, "Credentials".

# --- Meridian Field, Android (upload keystore) ---------------------------
# Path to the upload keystore, held outside the repository. `~/` and Git Bash
# `/c/...` spellings are accepted as well as native paths.
MERIDIAN_ANDROID_UPLOAD_KEYSTORE_FILE=
MERIDIAN_ANDROID_UPLOAD_KEYSTORE_PASSWORD=
MERIDIAN_ANDROID_UPLOAD_KEY_ALIAS=
MERIDIAN_ANDROID_UPLOAD_KEY_PASSWORD=

# --- Meridian Field, iOS (Apple distribution signing) --------------------
# Apple Developer team identifier: the 10-character Team ID from
# developer.apple.com -> Membership details.
MERIDIAN_IOS_TEAM_ID=

# The distribution signing identity's *common name*, exactly as the build
# Mac's login Keychain spells it — not a file, path, or fingerprint. List the
# identities the machine can sign with:
#
#   security find-identity -v -p codesigning
#
# and copy the quoted name, which looks like:
#
#   Apple Distribution: Example Org (ABCDE12345)
#
# If nothing of that form is listed, the certificate is not installed yet;
# create an Apple Distribution certificate under Certificates, Identifiers &
# Profiles and install it (release-packaging.md, "One-time provisioning").
MERIDIAN_IOS_DISTRIBUTION_CERTIFICATE=

# The *name* of the App Store provisioning profile for org.meridian.field —
# the name given when it was created at developer.apple.com, not the bundle
# identifier and not the .mobileprovision filename. Names of the profiles
# installed on this Mac:
#
#   for p in ~/Library/Developer/Xcode/UserData/Provisioning\ Profiles/*.mobileprovision; do \
#     security cms -D -i "$p" | plutil -extract Name raw -; done
#
# (older Xcode versions keep them in ~/Library/MobileDevice/Provisioning Profiles).
MERIDIAN_IOS_PROVISIONING_PROFILE=
