# PowerSync API port exposed on the host.
POWERSYNC_PORT=8080

# Canonical Meridian PostgreSQL source. The configured role must have logical
# replication access. Use sslmode=verify-full outside a private development
# network.
PS_DATA_SOURCE_URI=postgresql://powersync_replication:replace-me@host.docker.internal:5432/meridian
PS_DATA_SOURCE_SSLMODE=disable

# PowerSync bucket storage must use a dedicated database/user even when it is
# hosted on the same PostgreSQL server.
PS_BUCKET_STORAGE_URI=postgresql://powersync_storage:replace-me@host.docker.internal:5432/powersync_storage
PS_BUCKET_STORAGE_SSLMODE=disable

# Laravel or the configured identity service will expose this JWKS endpoint in
# the owning authentication integration task. Do not use a fake endpoint for
# event or production deployments.
PS_JWKS_URI=http://host.docker.internal:8000/api/powersync/jwks
PS_JWT_AUDIENCE=meridian

PS_LOG_LEVEL=info
