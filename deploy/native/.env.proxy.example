# /etc/meridian-proxy.env — the proxy half of the deployment configuration.
#
# These are the `web` service's environment variables from
# compose.deployment.yaml. They stay out of apps/server/.env because Caddy runs
# as its own service and never reads Laravel's environment file.

# Which configuration runs. See deploy/docker/.env.deployment.example for what
# each one serves.
MERIDIAN_CADDYFILE=/etc/caddy/Caddyfile

# The hostname on the certificate, and the site address Caddy serves. Must match
# the host in APP_URL. CHANGE ME.
MERIDIAN_SITE_ADDRESS=meridian.example.org

# php-fpm, over the unix socket the Meridian pool listens on. In Compose this
# was `server:9000` across a container network; on one host a socket avoids the
# TCP hop, and there is no SCRIPT_FILENAME path mismatch to worry about because
# the proxy and PHP share a filesystem.
MERIDIAN_SERVER_UPSTREAM=unix//run/php/php8.5-fpm-meridian.sock

# Where the certificate authority sends renewal-failure notices. ACME only.
MERIDIAN_ACME_EMAIL=

# Event node only: the pre-provisioned certificate, as paths on this host.
# install-host.sh creates /etc/caddy/tls for them.
MERIDIAN_TLS_CERTIFICATE=
MERIDIAN_TLS_KEY=

# Caddyfile.wildcard only.
MERIDIAN_WILDCARD_TLS_CERTIFICATE=
MERIDIAN_WILDCARD_TLS_KEY=
