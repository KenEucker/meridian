[Unit]
# The `scheduler` service from compose.deployment.yaml. Node-to-node sync runs
# every minute, the diagnostics heartbeat that proves the scheduler is firing
# runs every minute, health reports every ten, and the organization lifecycle
# thresholds daily (apps/server/routes/console.php). None of them is triggered
# by a person, so a node without this is one where on-site never pushes back to
# central.
#
# `schedule:work` rather than a crontab entry, so the schedule stays defined in
# routes/console.php and nothing has to be mirrored into cron.
Description=Meridian scheduler
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=meridian.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=@MERIDIAN_ROOT@/apps/server
Environment=MERIDIAN_CONTAINER_ROLE=scheduler
ExecStart=/usr/bin/php@PHP_VERSION@ artisan schedule:work
Restart=always
RestartSec=2
TimeoutStopSec=60
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
