# Meridian node configuration — native install.
#
# Copy to /var/www/meridian/apps/server/.env and replace every value marked
# CHANGE ME. This is deploy/docker/.env.deployment.example with the container-
# only keys removed and three values changed for a host install; every key it
# does not mention is documented in apps/server/.env.example, which is the full
# catalogue.
#
# Removed: MERIDIAN_IMAGE and MERIDIAN_IMAGE_TAG (no images to tag — the server
# reads its build version from the root package.json in the checkout), and the
# MERIDIAN_SITE_ADDRESS / MERIDIAN_CADDYFILE / MERIDIAN_*_TLS_* block, which
# lives in /etc/meridian-proxy.env because Caddy runs as its own service and
# never reads this file.
#
# Production and event modes refuse to boot with default secrets, so a node
# started with this file unedited does not run: deploy-release.sh stops and
# names what is outstanding. `php artisan meridian:secrets` asks the same
# question at any time and never prints a value.

# ---------------------------------------------------------------------------
# Node identity and role
# ---------------------------------------------------------------------------
# One of: standalone, central, onsite. Any non-development role is event mode,
# so the fail-closed safeguards apply — including the HTTPS requirement.
MERIDIAN_NODE_ROLE=standalone

# CHANGE ME.
MERIDIAN_NODE_NAME=Meridian Standalone

# Where an on-site node reaches central. Blank on central and standalone.
MERIDIAN_CENTRAL_NODE_URL=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Meridian
APP_ENV=production
APP_DEBUG=false

# Event mode validates that this URL uses HTTPS and fails closed when it does
# not. It is also the host organization subdomains are derived from, so it must
# be the deployment's real name, and its host must match MERIDIAN_SITE_ADDRESS
# in /etc/meridian-proxy.env. CHANGE ME.
APP_URL=https://meridian.example.org

# Generate one per node and never share it — README.md step 3, which installs
# the server's dependencies first because `artisan` cannot boot without them:
#   sudo -u www-data php8.5 artisan key:generate --show
# CHANGE ME.
APP_KEY=

# CHANGED FOR A NATIVE INSTALL. The image set this as a build-time ENV so a
# deployed server always served the built artifact. Set explicitly here for the
# same reason.
MERIDIAN_CLIENT_USE_DEV_SERVER=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# CHANGED FOR A NATIVE INSTALL: `postgres` was the Compose service name.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=meridian
DB_USERNAME=meridian

# CHANGE ME. The same password install-host.sh was run with.
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions, cache, and queue
# ---------------------------------------------------------------------------
# All three are database-backed, which is why this node needs no Redis or
# Memcached beside it.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Magic-link login and the operational notification set both need working mail.
# A node that cannot send mail is a node nobody can log in to by email.
# CHANGE ME.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=meridian@example.org
MAIL_FROM_NAME=Meridian

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# CHANGED FOR A NATIVE INSTALL. `stderr` made the container's logs the node's
# logs; under php-fpm it lands in the pool's error log with a worker prefix.
# `daily` writes storage/logs/laravel-<date>.log and rotates itself, and the
# worker and scheduler journals carry the rest (`journalctl -u meridian-worker`).
LOG_CHANNEL=daily
LOG_LEVEL=warning
