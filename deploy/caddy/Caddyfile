# Meridian reverse proxy — internet-reachable node.
#
# For a central or standalone node with a public hostname that resolves from the
# internet. Caddy obtains and renews the certificate itself over ACME, which needs
# inbound port 80 and 443 to reach this host.
#
# An event node on a field network cannot complete an ACME challenge, because the
# network it is on has no route from the internet. Use `Caddyfile.onsite` there:
# it serves a certificate provisioned before the event (technical spec 8.3).
#
# Organization subdomains resolve at `<organization-slug>.<deployment-domain>`
# (technical spec 8.7). This file serves the deployment root only, where the
# root-path form of organization addressing works. To serve the subdomain form
# as well, run `Caddyfile.wildcard` instead (MERIDIAN_CADDYFILE): it adds the
# wildcard host with a pre-provisioned wildcard certificate, which is the part
# ACME over HTTP cannot obtain — a wildcard needs the DNS-01 challenge and a
# DNS provider decision this file cannot make.
{
	# Where the certificate authority sends expiry and problem notices. ACME
	# issuance works without it; finding out about a renewal failure does not.
	email {$MERIDIAN_ACME_EMAIL}
}

import /etc/caddy/meridian.snippet

{$MERIDIAN_SITE_ADDRESS} {
	import meridian-app
}
