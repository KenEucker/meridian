# Meridian deployment configuration.
#
# Copy to deploy/docker/.env.deployment and replace every value marked CHANGE ME.
# Never commit the copy: it holds the node's secrets, and it is the one file that
# must not be copied between nodes — two nodes sharing a signing key cannot be
# told apart by the node they sync with.
#
# Every value here is fake on purpose (technical spec 26.2: sample configs use
# fake values only). Production and event modes refuse to boot with default
# secrets, so a node started with this file unedited does not run.
#
# This file is both the environment the containers receive and the source Compose
# interpolates the stack's own values from, so the pnpm deploy scripts pass it to
# `--env-file`. Keys the server itself reads are documented in
# apps/server/.env.example, which is the full catalogue; only the keys a
# deployment must decide are repeated here.

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# The Meridian version being deployed (technical spec 26.3, Docker image tags).
# It must be the root package.json version the images were built from: the server
# reports it as its build version, and a tag that disagrees with the code inside
# the image makes every version display in the product a lie. `pnpm run
# deploy:build` reads the root version and tags with it.
# CHANGE ME to the version being deployed.
MERIDIAN_IMAGE_TAG=0.0.0

# The image name, without the tag. Set a registry prefix here when the images are
# pulled rather than built on the node.
MERIDIAN_IMAGE=meridian/server

# ---------------------------------------------------------------------------
# Node identity and role
# ---------------------------------------------------------------------------
# Which node this is (technical spec 7.1, 26.1). One of: standalone, central,
# onsite. `development` is not a deployment role and this stack does not serve it.
# Any non-development role is event/production mode, so the fail-closed
# safeguards apply (technical spec 26.2).
MERIDIAN_NODE_ROLE=standalone

# The node's human name, shown in the Electron health panel and used in pairing.
# CHANGE ME.
MERIDIAN_NODE_NAME=Meridian Standalone

# Where an on-site node reaches central. Leave blank on central and standalone;
# pairing writes the rest of the pairing state itself.
MERIDIAN_CENTRAL_NODE_URL=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Meridian
APP_ENV=production
APP_DEBUG=false

# Event mode validates that this URL uses HTTPS and fails closed when it does not
# (technical spec 8.2, 8.6). It is also the host organization subdomains are
# derived from (technical spec 8.7), so it must be the deployment's real name.
# CHANGE ME.
APP_URL=https://meridian.example.org

# Laravel's encryption key, protecting sessions, encrypted casts, and the
# configuration override store. Generate one per node and never share it:
#   docker compose run --rm server php artisan key:generate --show
# CHANGE ME.
APP_KEY=

# ---------------------------------------------------------------------------
# Reverse proxy and TLS
# ---------------------------------------------------------------------------
# The hostname on the certificate, and the site address Caddy serves. Matches the
# host in APP_URL. CHANGE ME.
MERIDIAN_SITE_ADDRESS=meridian.example.org

# Which Caddyfile the proxy runs.
#   /etc/caddy/Caddyfile          internet-reachable node; Caddy obtains the
#                                 certificate itself over ACME.
#   /etc/caddy/Caddyfile.onsite   event node; serves a certificate provisioned
#                                 before the event, with ACME switched off.
MERIDIAN_CADDYFILE=/etc/caddy/Caddyfile

# Where the certificate authority sends renewal-failure notices. Used by the
# ACME Caddyfile only. CHANGE ME or leave blank.
MERIDIAN_ACME_EMAIL=

# On-site only: the pre-provisioned certificate and key, as paths inside the
# proxy container. MERIDIAN_TLS_DIRECTORY on the host is mounted read-only at
# /etc/caddy/tls, so a certificate placed in that directory is reachable at
# /etc/caddy/tls/<filename>. Leave all three blank on a node using ACME.
MERIDIAN_TLS_DIRECTORY=./tls
MERIDIAN_TLS_CERTIFICATE=
MERIDIAN_TLS_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# `postgres` is the service in this stack. Point it at a managed instance and
# remove the postgres service from the Compose file to use one instead.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=meridian
DB_USERNAME=meridian

# CHANGE ME. This is the deployment's database password and the sample value is
# not one.
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions, cache, and queue
# ---------------------------------------------------------------------------
# All three are database-backed, which is why a Meridian deployment needs no
# Redis or Memcached container beside it.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Host-only session cookies keep organization subdomains isolated from one
# another (technical spec 8.7). Leave blank unless a deliberate decision says
# otherwise; setting a parent domain here shares sessions across every
# organization subdomain.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Magic-link login and the operational notification set both need working mail
# (NOTIFY-001). A node that cannot send mail is a node nobody can log in to by
# email. CHANGE ME.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=meridian@example.org
MAIL_FROM_NAME=Meridian

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# stderr so the container's logs are the node's logs, readable with
# `docker compose logs` and collectable by whatever the host already runs.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
