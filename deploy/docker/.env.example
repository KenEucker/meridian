# Meridian database service configuration (deploy/docker).
#
# Copy this file to deploy/docker/.env before starting the stack. The values
# below are development defaults that match apps/server/.env.example so a fresh
# checkout runs without edits. Replace every password with a strong secret for
# any event or production deployment. Never commit deploy/docker/.env.

# Canonical Meridian database. These mirror the DB_* keys in
# apps/server/.env.example so the server connects without extra configuration.
DB_DATABASE=meridian
DB_USERNAME=meridian
DB_PASSWORD=meridian
DB_PORT=5432
