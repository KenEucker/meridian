# Meridian database service configuration (deploy/docker).
#
# Copy this file to deploy/docker/.env before starting the stack. The values
# below are development defaults that match apps/server/.env.example so a fresh
# checkout runs without edits. Replace every password with a strong secret for
# any event or production deployment. Never commit deploy/docker/.env.

# Canonical Meridian database. These mirror the DB_* keys in
# apps/server/.env.example so the server connects without extra configuration.
DB_DATABASE=meridian
DB_USERNAME=meridian
DB_PASSWORD=meridian
DB_PORT=5432

# Least-privilege PowerSync logical-replication role on the canonical database.
# The user/password must match the credentials in PS_DATA_SOURCE_URI in
# deploy/powersync/.env.
POWERSYNC_REPLICATION_USER=powersync_replication
POWERSYNC_REPLICATION_PASSWORD=powersync_replication

# Dedicated PowerSync bucket-storage database and owner role. The database, user,
# and password must match PS_BUCKET_STORAGE_URI in deploy/powersync/.env.
POWERSYNC_STORAGE_DB=powersync_storage
POWERSYNC_STORAGE_USER=powersync_storage
POWERSYNC_STORAGE_PASSWORD=powersync_storage

# Logical replication publication PowerSync consumes from the canonical database.
POWERSYNC_PUBLICATION=powersync
