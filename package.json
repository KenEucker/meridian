{
  "name": "meridian",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source volunteer operations platform for events.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "meridian": {
    "python": ">=3.10"
  },
  "scripts": {
    "process:traceability": "python scripts/process/validate_traceability_matrix.py",
    "process:qa": "python scripts/process/validate_qa_docs.py",
    "process:repo": "python scripts/process/validate_repo_process.py",
    "process:pr-template": "python scripts/process/validate_pr_body.py --body-file .github/pull_request_template.md",
    "process:pr-body": "python scripts/process/test_validate_pr_body.py",
    "commit:check": "python scripts/process/validate_conventional_commits.py",
    "commit:check-example": "python scripts/process/validate_conventional_commits.py --message \"docs(process): validate commit format\"",
    "process:check": "corepack pnpm run process:traceability && corepack pnpm run process:qa && corepack pnpm run process:repo && corepack pnpm run process:pr-template && corepack pnpm run process:pr-body && corepack pnpm run commit:check-example",
    "check": "corepack pnpm run process:check",
    "server:install": "composer --working-dir=apps/server install",
    "server:validate": "composer --working-dir=apps/server validate --no-check-publish",
    "server:env": "php -r \"file_exists('apps/server/.env') || copy('apps/server/.env.example', 'apps/server/.env');\"",
    "server:key": "php apps/server/artisan key:generate",
    "server:user": "php apps/server/artisan orchid:admin 'Admin' admin@example.com password",
    "server:setup": "corepack pnpm run server:env && corepack pnpm run server:key && corepack pnpm run server:migrate",
    "server:dev": "php apps/server/artisan serve",
    "server:logs": "node scripts/server/tail-laravel-log.mjs",
    "server:test": "php apps/server/artisan config:clear --ansi && php apps/server/artisan test",
    "server:artisan": "php apps/server/artisan",
    "server:migrate": "php apps/server/artisan migrate",
    "server:migrate:status": "php apps/server/artisan migrate:status",
    "server:migrate:seed": "php apps/server/artisan migrate:fresh --seed",
    "mobile:dev": "corepack pnpm --filter @meridian/mobile run dev",
    "mobile:build": "corepack pnpm --filter @meridian/mobile run build",
    "mobile:preview": "corepack pnpm --filter @meridian/mobile run preview",
    "mobile:typecheck": "corepack pnpm --filter @meridian/mobile run typecheck",
    "mobile:test": "corepack pnpm --filter @meridian/mobile run test",
    "mobile:cap:copy": "corepack pnpm --filter @meridian/mobile run cap:copy",
    "mobile:cap:sync": "corepack pnpm --filter @meridian/mobile run cap:sync",
    "desktop:start": "corepack pnpm --filter @meridian/desktop run start",
    "desktop:build": "corepack pnpm --filter @meridian/desktop run build",
    "desktop:typecheck": "corepack pnpm --filter @meridian/desktop run typecheck",
    "desktop:test": "corepack pnpm --filter @meridian/desktop run test",
    "tokens:sync": "node -e \"require('fs').copyFileSync('packages/ui-tokens/tokens.css','apps/server/public/css/meridian-tokens.css')\"",
    "tokens:typecheck": "corepack pnpm --filter @meridian/ui-tokens run typecheck",
    "tokens:test": "corepack pnpm --filter @meridian/ui-tokens run test",
    "build": "corepack pnpm run mobile:build && corepack pnpm run desktop:build",
    "typecheck": "corepack pnpm run tokens:typecheck && corepack pnpm run mobile:typecheck && corepack pnpm run desktop:typecheck",
    "test": "corepack pnpm run process:check && corepack pnpm run tokens:test && corepack pnpm run mobile:test && corepack pnpm run desktop:test"
  }
}
