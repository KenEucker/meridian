VITE_MERIDIAN_API_BASE_URL=http://127.0.0.1:8000
# Run `corepack pnpm run env:local` from the repository root to generate
# ignored `.env.*.local` files for every Vite UI mode.
#
# Install the local development session when nobody is signed in. Off by
# default since M18.9: with it on, a developer who has not signed in is shown a
# populated shell belonging to "Local Field Author" on "Local Field Event", and
# the seeded database's own staff, events, and departments are nowhere on
# screen. Sign in against a seeded node instead and the client shows that
# node's data. Turn this on to work on the shell with no server at all.
VITE_MERIDIAN_INSTALL_LOCAL_FIELD_SESSION=false
