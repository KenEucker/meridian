{
  "name": "@meridian/client",
  "private": true,
  "description": "Shared Meridian Vue client for Admin, Field, and Kiosk artifacts.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --mode meridian-field",
    "dev:admin": "vite --mode meridian-admin",
    "dev:field": "vite --mode meridian-field",
    "dev:kiosk": "vite --mode meridian-kiosk",
    "dev:kiosk:workstation": "vite --mode meridian-kiosk --host 127.0.0.1 --port 5175 --strictPort",
    "build": "vue-tsc --build --force && vite build --mode meridian-admin && vite build --mode meridian-field && vite build --mode meridian-kiosk",
    "build:admin": "vite build --mode meridian-admin",
    "build:field": "vite build --mode meridian-field",
    "build:kiosk": "vite build --mode meridian-kiosk",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run",
    "cap:copy": "cap copy",
    "cap:sync": "cap sync"
  },
  "dependencies": {
    "@meridian/ui-tokens": "workspace:*",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^2.2.0"
  }
}
