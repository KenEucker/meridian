# The shared-workstation Kiosk (M18.32; technical spec 13.1).
#
# `pnpm run kiosk:workstation` writes `apps/kiosk/.env.shared-workstation`
# from this file, fills in the workstation the node provisioned, and hands the
# result to Electron. Edit that file to pin the values; the launcher only fills
# in what is missing, so anything set there survives the next run.
#
# None of this is a credential. The workstation identifier grants nothing on its
# own (AUTH-030): signing in still needs a login code the node issued to a named
# person, and the node still requires the workstation to be trusted.

# The trusted shared workstation this machine is. Written by the launcher after
# `php artisan meridian:shared-workstation` provisions it; set it yourself to
# point the desktop app at a workstation that already exists.
MERIDIAN_SHARED_WORKSTATION_ID=

# The node the Kiosk and the wrapper's health panel talk to.
MERIDIAN_SERVER_URL=http://127.0.0.1:8000/

# The Vite dev server the wrapper loads the Kiosk from. Its own port, so it can
# run beside a shared client already holding 5173; the port is in the server's
# default CORS origins for the same reason.
MERIDIAN_CLIENT_DEV_SERVER_URL=http://127.0.0.1:5175/

# Open in a resizable window instead of fullscreen kiosk.
#
# Off, because a Kiosk is fullscreen and locked down and testing one in a window
# is testing something else — the touch layout, the reading distance, and the
# absence of anywhere else to go are the point. Close it with Alt+F4; the health
# panel is still Ctrl+Shift+H.
#
# Turn it on when you are working on the surfaces rather than the workstation and
# need the rest of your machine.
MERIDIAN_DESKTOP_WINDOWED=false
