{
  "name": "@meridian/kiosk",
  "private": true,
  "description": "Meridian Electron on-site workstation wrapper shell for Meridian Kiosk.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.0.0",
  "main": "dist/main.js",
  "scripts": {
    "compile": "tsc --project tsconfig.build.json",
    "start": "tsc --project tsconfig.build.json && electron .",
    "build": "corepack pnpm --filter @meridian/client run build:kiosk && tsc --project tsconfig.build.json",
    "package": "corepack pnpm run build && node ../../scripts/release/package-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
