# Meridian server environment. This file is also the System Configuration
# catalogue: God Mode reads it to learn which environment variables exist, what
# they mean, and whether a database override is safe (technical spec 22A).
#
# Catalogue metadata tags. A `# @tag` comment applies to the next variable:
#   @label <text>            human-readable label
#   @type <t>                string|boolean|integer|float|json|url|duration|enum:a|b|c
#   @config <key[,key]>      Laravel config key(s) the variable feeds
#   @secret                  encrypted at rest, masked everywhere, never exported
#   @required                must be configured for the node to operate
#   @bootstrap               bootstrap-locked: needed before overrides can load,
#                            so no database override is possible
#   @managed <label>         written by Meridian itself (setup/pairing); edit it
#                            on the named screen, not here
#   @readonly                catalogued but never overridable from the database
#   @restart workers|deploy  activation needs more than new web requests
# A variable with no @config tag is treated as unmapped and stays read-only.

## Application

# @label Application name
# @type string
# @config app.name
APP_NAME=Meridian

# The runtime environment decides which providers and safeguards boot, so it
# must exist before database overrides load.
# @label Application environment
# @type string
# @config app.env
# @required
# @bootstrap
APP_ENV=local

# The encryption key protects sessions, encrypted casts, and the override
# store itself, so it can never come from the override store.
# @label Application key
# @type string
# @config app.key
# @secret
# @required
# @bootstrap
APP_KEY=

# @label Debug mode
# @type boolean
# @config app.debug
APP_DEBUG=true

# Event mode validates this URL for HTTPS (technical spec 8.2, 26.2).
# @label Application URL
# @type url
# @config app.url
# @required
APP_URL=http://127.0.0.1:8000

# @label Locale
# @type string
# @config app.locale
APP_LOCALE=en

# @label Fallback locale
# @type string
# @config app.fallback_locale
APP_FALLBACK_LOCALE=en

# @label Faker locale
# @type string
# @readonly
APP_FAKER_LOCALE=en_US

# Maintenance mode is consulted before the application fully boots.
# @label Maintenance driver
# @type enum:file|cache
# @config app.maintenance.driver
# @bootstrap
APP_MAINTENANCE_DRIVER=file
# @label Maintenance store
# @type string
# @config app.maintenance.store
# @bootstrap
# APP_MAINTENANCE_STORE=database

## Meridian build

# Build/version metadata surfaced by GET /api/health. The running version is
# resolved from the repository root package manifest, not from this variable.
# @label Meridian version
# @type string
# @readonly
MERIDIAN_VERSION=0.1.0-alpha

# @label Config schema version
# @type integer
# @config meridian.config_schema_version
# @readonly
MERIDIAN_CONFIG_SCHEMA_VERSION=1

## Node identity and pairing

# Node identity is administered on Infrastructure -> Node Configuration and is
# stored through the node config override path (technical spec 7.3). These
# variables seed a deployment; the console is where they are maintained.
# @label Node name
# @type string
# @config meridian.node.name
# @managed Node Configuration
MERIDIAN_NODE_NAME=
# @label Node role
# @type enum:development|standalone|central|onsite
# @config meridian.node.role
# @managed Node Configuration
MERIDIAN_NODE_ROLE=
# @label Node public key
# @type string
# @config meridian.node.public_key
# @managed Node Configuration
MERIDIAN_NODE_PUBLIC_KEY=
# The node signing key must be readable before overrides are trusted, and
# replacing it orphans every operation this node has signed.
# @label Node private key
# @type string
# @config meridian.node.private_key
# @secret
# @bootstrap
MERIDIAN_NODE_PRIVATE_KEY=
# @label Central node URL
# @type url
# @config meridian.node.central_node_url
# @managed Node Configuration
MERIDIAN_CENTRAL_NODE_URL=
# Central pairing state (M12.1). Normally written by pairing as database
# overrides; set here only when a deployment ships a known central identity.
# @label Central node name
# @type string
# @config meridian.node.central_node_name
# @managed Node Configuration pairing
MERIDIAN_CENTRAL_NODE_NAME=
# @label Central node public key
# @type string
# @config meridian.node.central_node_public_key
# @managed Node Configuration pairing
MERIDIAN_CENTRAL_NODE_PUBLIC_KEY=
# @label Central node URL at pairing
# @type url
# @config meridian.node.central_node_paired_url
# @managed Node Configuration pairing
MERIDIAN_CENTRAL_NODE_PAIRED_URL=
# @label Central node paired at
# @type string
# @config meridian.node.central_node_paired_at
# @managed Node Configuration pairing
MERIDIAN_CENTRAL_NODE_PAIRED_AT=
# @label Pairing request timeout
# @type duration
# @config meridian.node.pairing.request_timeout_seconds
MERIDIAN_NODE_PAIRING_TIMEOUT_SECONDS=10

## Node-to-node sync

# Node-to-node sync loop (M12.5). On-site pushes to central continuously when
# internet exists and queues operations when it does not, so the loop runs on
# the scheduler; disable it on installs that never sync.
# @label Node sync schedule enabled
# @type boolean
# @config meridian.node.sync.schedule_enabled
MERIDIAN_NODE_SYNC_SCHEDULE_ENABLED=true
# @label Node sync batch size
# @type integer
# @config meridian.node.sync.batch_size
MERIDIAN_NODE_SYNC_BATCH_SIZE=100
# @label Node sync max exchanges per run
# @type integer
# @config meridian.node.sync.max_exchanges_per_run
MERIDIAN_NODE_SYNC_MAX_EXCHANGES_PER_RUN=10
# @label Node sync request timeout
# @type duration
# @config meridian.node.sync.request_timeout_seconds
MERIDIAN_NODE_SYNC_TIMEOUT_SECONDS=15
# @label Node sync max request age
# @type duration
# @config meridian.node.sync.max_request_age_seconds
MERIDIAN_NODE_SYNC_MAX_REQUEST_AGE_SECONDS=300

## Authentication

# @label Magic link account creation
# @type boolean
# @config meridian.magic_link.allow_account_creation
MERIDIAN_MAGIC_LINK_ALLOW_ACCOUNT_CREATION=true
# @label OAuth post-login redirect
# @type string
# @config meridian.oauth.post_login_redirect
MERIDIAN_OAUTH_REDIRECT=/home

# How long an issued API bearer token stays valid (AUTH-024). The documented
# default is 60480 minutes — six weeks — matching the trusted-session window in
# technical spec 11.2, because users authenticate before an event while internet
# exists and the event may then run for days without connectivity. This is
# independent of the 5-minute shared-workstation inactivity timeout. Lowering it
# also expires tokens already issued, at their next request.
# @label API token lifetime (minutes)
# @type integer
# @config meridian.api_tokens.expiration_minutes,sanctum.expiration
MERIDIAN_API_TOKEN_EXPIRATION_MINUTES=60480

# How long a mailed API login code can be exchanged for a token.
# @label API login code lifetime (minutes)
# @type integer
# @config meridian.api_tokens.login_code.expires_minutes
MERIDIAN_API_LOGIN_CODE_EXPIRES_MINUTES=15

# How many wrong guesses retire an issued login code. Route throttling bounds
# the rate of attempts; this bounds the total against one code.
# @label API login code attempt limit
# @type integer
# @config meridian.api_tokens.login_code.attempt_limit
MERIDIAN_API_LOGIN_CODE_ATTEMPT_LIMIT=5

# How long a Google or Discord system-browser handoff stays live (AUTH-020),
# covering the whole round trip: starting the handoff, signing in at the
# provider, and exchanging the returned code for a token. A person is waiting
# through all of it, so this is short.
# @label Provider handoff lifetime (minutes)
# @type integer
# @config meridian.api_tokens.provider_handoff.expires_minutes
MERIDIAN_API_HANDOFF_EXPIRES_MINUTES=10

# Where a completed provider handoff returns the system browser, per client
# target. The client names which target it is and the node resolves the address
# from here, so a login request cannot nominate a return address of its own.
# Blank an entry to disable provider login for that client target.
#
# The web target is an address on the client's own origin; it defaults to
# APP_URL because the node serves the Admin client. The mobile and desktop
# targets are custom schemes the packaged applications register with the
# operating system, and must match what those builds register.
# @label Provider handoff return target (web client)
# @type url
# @config meridian.api_tokens.provider_handoff.return_targets.web
MERIDIAN_API_HANDOFF_RETURN_WEB=http://127.0.0.1:8000/login/handoff
# @label Provider handoff return target (mobile Field)
# @type string
# @config meridian.api_tokens.provider_handoff.return_targets.mobile
MERIDIAN_API_HANDOFF_RETURN_MOBILE=org.meridian.field://auth/handoff
# @label Provider handoff return target (desktop)
# @type string
# @config meridian.api_tokens.provider_handoff.return_targets.desktop
MERIDIAN_API_HANDOFF_RETURN_DESKTOP=org.meridian.kiosk://auth/handoff

## Meridian Admin client

# @label Use client dev server
# @type boolean
# @config meridian.client.use_dev_server
MERIDIAN_CLIENT_USE_DEV_SERVER=true
# @label Client dev server URL
# @type url
# @config meridian.client.dev_server_url
MERIDIAN_CLIENT_DEV_SERVER_URL=http://localhost:5173

## PowerSync

# Self-hosted PowerSync server-to-device sync service (M8.1).
# @label PowerSync URL
# @type url
# @config powersync.endpoint
POWERSYNC_URL=http://127.0.0.1:8080
# @label PowerSync liveness path
# @type string
# @config powersync.liveness_path
POWERSYNC_LIVENESS_PATH=/probes/liveness
# @label PowerSync request timeout
# @type duration
# @config powersync.request_timeout_seconds
POWERSYNC_REQUEST_TIMEOUT_SECONDS=2

## Event mode

# Event-mode fail-closed safeguards (M8.7; technical spec 8.6, 26.2). Leave
# MERIDIAN_EVENT_MODE unset to derive event mode from the node role (any
# non-development role is event mode); set true/false to force it. The require_*
# flags default on so a misconfigured event node fails closed.
# @label Force event mode
# @type boolean
# @config meridian.event_mode.enabled
MERIDIAN_EVENT_MODE=
# @label Event mode requires HTTPS
# @type boolean
# @config meridian.event_mode.require_https
MERIDIAN_EVENT_MODE_REQUIRE_HTTPS=true
# @label Event mode requires PowerSync
# @type boolean
# @config meridian.event_mode.require_powersync
MERIDIAN_EVENT_MODE_REQUIRE_POWERSYNC=true

## External login providers

# Google OAuth login (Alpha 1 external-provider auth).
# @label Google OAuth client ID
# @type string
# @config meridian.oauth.google.client_id
GOOGLE_OAUTH_CLIENT_ID=
# @label Google OAuth client secret
# @type string
# @config meridian.oauth.google.client_secret
# @secret
GOOGLE_OAUTH_CLIENT_SECRET=
# @label Google OAuth redirect URI
# @type url
# @config meridian.oauth.google.redirect_uri
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/login/google/callback

# Discord OAuth login (Alpha 1 external-provider auth).
# @label Discord OAuth client ID
# @type string
# @config meridian.oauth.discord.client_id
DISCORD_OAUTH_CLIENT_ID=
# @label Discord OAuth client secret
# @type string
# @config meridian.oauth.discord.client_secret
# @secret
DISCORD_OAUTH_CLIENT_SECRET=
# @label Discord OAuth redirect URI
# @type url
# @config meridian.oauth.discord.redirect_uri
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/login/discord/callback

## Changelog refresh

# Central-node changelog refresh from the source repository (GOD-022 through
# GOD-026). The token is optional and raises the unauthenticated rate limit.
# @label Changelog refresh enabled
# @type boolean
# @config meridian.changelog.refresh.enabled
MERIDIAN_CHANGELOG_REFRESH_ENABLED=true
# @label Changelog source repository
# @type string
# @config meridian.changelog.refresh.repository
MERIDIAN_CHANGELOG_REPOSITORY=KenEucker/meridian
# @label Changelog refresh token
# @type string
# @config meridian.changelog.refresh.token
# @secret
MERIDIAN_CHANGELOG_TOKEN=

## PHP runtime

# @label PHP CLI server workers
# @type integer
# @readonly
# @restart deploy
# PHP_CLI_SERVER_WORKERS=4

# @label Bcrypt rounds
# @type integer
# @config hashing.bcrypt.rounds
BCRYPT_ROUNDS=12

## Logging

# @label Log channel
# @type string
# @config logging.default
LOG_CHANNEL=stack
# @label Log stack channels
# @type string
# @readonly
LOG_STACK=single
# @label Deprecations log channel
# @type string
# @readonly
LOG_DEPRECATIONS_CHANNEL=null
# Consumed by several logging channels at once, so it is catalogued but not
# overridable from the database.
# @label Log level
# @type string
# @readonly
LOG_LEVEL=debug

## Database

# Primary database credentials are required before the override store can be
# read, so none of them can be overridden from the database.
# @label Database connection
# @type string
# @config database.default
# @required
# @bootstrap
DB_CONNECTION=pgsql
# @label Database host
# @type string
# @config database.connections.pgsql.host
# @required
# @bootstrap
DB_HOST=127.0.0.1
# @label Database port
# @type integer
# @config database.connections.pgsql.port
# @required
# @bootstrap
DB_PORT=5432
# @label Database name
# @type string
# @config database.connections.pgsql.database
# @required
# @bootstrap
DB_DATABASE=meridian
# @label Database username
# @type string
# @config database.connections.pgsql.username
# @required
# @bootstrap
DB_USERNAME=meridian
# @label Database password
# @type string
# @config database.connections.pgsql.password
# @secret
# @required
# @bootstrap
DB_PASSWORD=meridian
# @label Database SSL mode
# @type string
# @config database.connections.pgsql.sslmode
# @bootstrap
# DB_SSLMODE=prefer

## Session

# The session store is resolved while the application boots.
# @label Session driver
# @type string
# @config session.driver
# @bootstrap
SESSION_DRIVER=database
# @label Session lifetime
# @type duration
# @config session.lifetime
SESSION_LIFETIME=120
# @label Encrypt session data
# @type boolean
# @config session.encrypt
SESSION_ENCRYPT=false
# @label Session cookie path
# @type string
# @config session.path
SESSION_PATH=/
# @label Session cookie domain
# @type string
# @config session.domain
SESSION_DOMAIN=null

## Broadcasting, filesystem, and attachments

# @label Broadcast connection
# @type string
# @config broadcasting.default
BROADCAST_CONNECTION=log
# @label Default filesystem disk
# @type string
# @config filesystems.default
FILESYSTEM_DISK=local
# Private disk for Field Report / domain attachment blobs (technical spec 18.5).
# @label Attachments disk
# @type string
# @config filesystems.attachments_disk
MERIDIAN_ATTACHMENTS_DISK=attachments
# @label Field report photo signed URL lifetime
# @type duration
# @config meridian.field_report_photos.signed_url_expires_minutes
MERIDIAN_FIELD_REPORT_PHOTO_SIGNED_URL_MINUTES=5

## Local development Field API

# Local Field app command auth (development only). From the repository root,
# `corepack pnpm run setup:local` enables this, configures matching client Vite
# env files, and seeds the well-known fixture.
# @label Local Field API enabled
# @type boolean
# @config meridian.local_field_api.enabled
MERIDIAN_LOCAL_FIELD_API_ENABLED=false
# @label Local Field API token
# @type string
# @config meridian.local_field_api.token
# @secret
MERIDIAN_LOCAL_FIELD_API_TOKEN=local-field-dev-token
# @label Local Field API user
# @type string
# @config meridian.local_field_api.user_id
MERIDIAN_LOCAL_FIELD_API_USER_ID=22222222-2222-4222-8222-222222222222
# Consumed through an explode() call, so it is catalogued but not overridable
# from the database.
# @label CORS allowed origins
# @type string
# @readonly
MERIDIAN_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

## Queue

# Queue workers hold their configuration for the life of the worker process,
# so queue changes need a worker restart to be fully active.
# @label Queue connection
# @type string
# @config queue.default
# @restart workers
QUEUE_CONNECTION=database

## Cache

# The cache store holds the catalogue metadata cache the override system reads
# while booting, so it cannot itself come from the override store.
# @label Cache store
# @type string
# @config cache.default
# @bootstrap
CACHE_STORE=database
# @label Cache key prefix
# @type string
# @config cache.prefix
# @bootstrap
# CACHE_PREFIX=

# @label Memcached host
# @type string
# @readonly
MEMCACHED_HOST=127.0.0.1

## Redis

# @label Redis client
# @type string
# @config database.redis.client
REDIS_CLIENT=phpredis
# @label Redis host
# @type string
# @config database.redis.default.host
REDIS_HOST=127.0.0.1
# @label Redis password
# @type string
# @config database.redis.default.password
# @secret
REDIS_PASSWORD=null
# @label Redis port
# @type integer
# @config database.redis.default.port
REDIS_PORT=6379

## Mail

# @label Mail transport
# @type string
# @config mail.default
MAIL_MAILER=log
# @label Mail scheme
# @type string
# @config mail.mailers.smtp.scheme
MAIL_SCHEME=null
# @label Mail host
# @type string
# @config mail.mailers.smtp.host
MAIL_HOST=127.0.0.1
# @label Mail port
# @type integer
# @config mail.mailers.smtp.port
MAIL_PORT=2525
# @label Mail username
# @type string
# @config mail.mailers.smtp.username
MAIL_USERNAME=null
# @label Mail password
# @type string
