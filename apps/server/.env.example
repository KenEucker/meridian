## Notifications

# The global send-suppression switch (M18.21; NOTIFY-009). While it is on,
# notifications are still recorded with everything they would have said and
# nothing is handed to a mail transport, so a test deployment or a database
# restored from production does not mail real people. It defaults to on
# everywhere APP_ENV is not `production`, which is the direction that fails
# safely: a forgotten setting on a staging box sends nothing, and a forgotten
# setting in production is a decision somebody had to type.
# @label Suppress notification email
# @type boolean
# @config meridian.notifications.suppressed
MERIDIAN_NOTIFICATIONS_SUPPRESSED=true
# How many times a queued notification is attempted before it is recorded as
# failed. A delivery failure never rolls back the operation that caused it
# (NOTIFY-006), so this bounds retrying rather than protecting anything.
# @label Notification send attempts
# @type integer
# @config meridian.notifications.max_attempts
MERIDIAN_NOTIFICATION_MAX_ATTEMPTS=3
# The queue notification sends are dispatched onto. Kept separate from the
# default queue so a backlog of mail never delays anything else on the node.
# @label Notification queue
# @type string
# @config meridian.notifications.queue
MERIDIAN_NOTIFICATION_QUEUE=notifications
# Where a notification's action link sends the recipient. Defaults to APP_URL,
# and is set explicitly where the product client is served from a different
# host than the API (NOTIFY-004).
# @label Notification link base URL
# @type string
# @config meridian.notifications.link_base_url
MERIDIAN_NOTIFICATION_LINK_BASE_URL=

## Object storage

# @label AWS access key ID
# @type string
# @config filesystems.disks.s3.key
AWS_ACCESS_KEY_ID=
# @label AWS secret access key
# @type string
# @config filesystems.disks.s3.secret
# @secret
AWS_SECRET_ACCESS_KEY=
# @label AWS region
# @type string
# @config filesystems.disks.s3.region
AWS_DEFAULT_REGION=us-east-1
# @label AWS bucket
# @type string
# @config filesystems.disks.s3.bucket
AWS_BUCKET=
# @label AWS path-style endpoint
# @type boolean
# @config filesystems.disks.s3.use_path_style_endpoint
AWS_USE_PATH_STYLE_ENDPOINT=false
