# Frontend app build output
apps/*/dist/
# Changelog data file, generated from repository history by the release build
# step (GOD-021). The packaged technician documentation beside it is committed
# because it mirrors authored content in docs/technician/; this one is derived
# from git history and would change on every merge.
apps/server/resources/changelog/
# Vue/TS incremental build info
*.tsbuildinfo
# Local pnpm content-addressable store fallback
.pnpm-store/
# Per-developer Claude Code settings. `.claude/launch.json` is committed because
# it describes how to run this project's dev servers; this file holds one
# developer's permission allowlist and absolute local paths.
.claude/settings.local.json
