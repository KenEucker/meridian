/vendor/
node_modules/
npm-debug.log
yarn-error.log

# Laravel 4 specific
bootstrap/compiled.php
app/storage/

# Laravel 5 & Lumen specific
public/storage
public/hot

# Laravel 5 & Lumen specific with changed public path
public_html/storage
public_html/hot

storage/*.key
.env
.env.*.local
# A deployment's own configuration, copied from
# deploy/docker/.env.deployment.example. It holds the node's APP_KEY, database
# password, and mail credentials, and must never be committed or copied between
# nodes (technical spec 26.2).
deploy/docker/.env.deployment
# An on-site node's pre-provisioned TLS certificate and key, mounted read-only
# into the proxy container.
deploy/docker/tls/
# Written by `pnpm run kiosk:workstation` and holding the workstation this
# machine was provisioned as. Not a credential (AUTH-030), but it is one
# developer's local machine identity and belongs to nobody else's checkout.
.env.shared-workstation
Homestead.yaml
Homestead.json
/.vagrant
.phpunit.result.cache

/public/build
/storage/pail
.env.backup
.env.production
.phpactor.json
auth.json

.DS_Store

# Frontend app build output
apps/*/dist/
# Desktop installer output from electron-builder (M19.20). Release artifacts
# are attached to releases, never committed (technical spec 26.7).
apps/kiosk/release/
# The release workflow's artifact staging directory (M19.23): saved images,
# the deployment bundle, and staged mobile packages land here before they are
# attached to the release. Same rule: attached, never committed.
release-artifacts/
# Changelog data file, generated from repository history by the release build
# step (GOD-021). The packaged technician documentation beside it is committed
# because it mirrors authored content in docs/technician/; this one is derived
# from git history and would change on every merge.
apps/server/resources/changelog/
# Vue/TS incremental build info
*.tsbuildinfo
# Local pnpm content-addressable store fallback
.pnpm-store/
# Per-developer Claude Code settings. `.claude/launch.json` is committed because
# it describes how to run this project's dev servers; this file holds one
# developer's permission allowlist and absolute local paths.
.claude/settings.local.json
